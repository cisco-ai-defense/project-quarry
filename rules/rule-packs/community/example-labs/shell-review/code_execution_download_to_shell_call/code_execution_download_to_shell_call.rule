rule "community/example-labs/shell-review/code_execution_download_to_shell_call"
metadata:
    title = "Download-to-shell command submitted to a shell tool"
    description = "Community example: a known shell tool receives a curl/wget pipeline to sh/bash in its command argument. This flags a command submission, not successful execution or proof that the action was unauthorized."
    author = "Cisco AI Defense"
    revision = "0"
    updated = "2026-10-14"
    requires_quarry = ">=0.1.0,<0.2.0"
    taxonomy_objective = "Action-Space and Integration Abuse"
    taxonomy_technique = "Tool Exploitation"
    taxonomy_subtechnique = "Unsafe System / Browser / File Execution"
    signal_channel = "tool_calls"
strings:
    $download_shell = "(?i)\b(curl|wget)\b[^\r\n|]*\|[ \t]*(sh|bash)\b" regex
condition:
    any call in tool_calls where
        (call.name == "execute_shell" or call.name == "run_shell" or call.name == "shell") and
        $download_shell in call.arguments.command
