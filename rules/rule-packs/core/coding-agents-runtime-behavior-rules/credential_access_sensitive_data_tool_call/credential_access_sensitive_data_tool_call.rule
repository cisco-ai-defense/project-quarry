rule "core/coding-agents-runtime-behavior-rules/credential_access_sensitive_data_tool_call"
metadata:
    title = "Sensitive data access in a tool call"
    description = "Select credential-store, sensitive-file, and environment indicators in tool calls and judge attempted access."
    author = "Cisco AI Defense"
    severity = "MEDIUM"
    revision = "0"
    updated = "2026-10-14"
    requires_quarry = ">=0.1.0,<0.2.0"
    taxonomy_objective = "Privilege Compromise"
    taxonomy_technique = "Unauthorized Access"
    taxonomy_subtechnique = "Credential Theft"
    signal_channel = "tool_calls"
strings:
    $secret_files = [".env", "/etc/shadow", ".aws/credentials", ".kube/config", ".docker/config.json", ".git-credentials", ".netrc", ".npmrc", "id_rsa", "id_ed25519"] nocase
    $secret_stores = ["gh auth token", "get-secret-value", "print-access-token", "vault kv get", "op read", "kubectl get secret", "kubectl config view --raw"] nocase
    $environment = [
        "printenv", "/proc/self/environ", "os.environ", "process.env", "DATABASE_URL",
        "API_KEY", "ACCESS_TOKEN", "AWS_SECRET_ACCESS_KEY", "GOOGLE_APPLICATION_CREDENTIALS"
    ] nocase
    $secret_data = [
        "password manager", "saved logins", "private key", "password_hash",
        "access_token", "refresh_token", "client secret", "session token",
        "service account key", "recovery codes"
    ] nocase
parameters:
    threshold: number
condition:
    any call in tool_calls where
        (call.raw_arguments contains_any $secret_files or
         call.raw_arguments contains_any $secret_stores or
         call.raw_arguments contains_any $environment or
         call.raw_arguments contains_any $secret_data) and
        (model("credential_access_judge").score(message("user", call.name).add_message("user", call.raw_arguments), text_ref("credential_access_judge_v1")) > params.threshold)
