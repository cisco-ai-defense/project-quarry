rule "core/coding-agents-runtime-behavior-rules/data_exfiltration_sensitive_data_in_tool_call"
metadata:
    title = "Sensitive data egress through a tool call"
    description = "Select transfer, connector, metadata, and sensitive-data indicators in tool calls and judge possible external egress."
    author = "Cisco AI Defense"
    severity = "HIGH"
    revision = "0"
    updated = "2026-10-14"
    requires_quarry = ">=0.1.0,<0.2.0"
    taxonomy_objective = "Data and Privacy Violations"
    taxonomy_technique = "Data Exfiltration / Exposure"
    taxonomy_subtechnique = "Data Exfiltration via Agent Tooling"
    signal_channel = "tool_calls"
strings:
    $transfer = [
        "curl", "wget", "scp", "sftp", "rsync", "Invoke-WebRequest", "Invoke-RestMethod",
        "requests.post", "httpx.post", "httpx.put", "upload", "sendmail",
        "send attachment", "forward message", "external recipient"
    ] nocase
    $network = [
        "/dev/tcp", "socat", "nc ", "netcat", "smbclient", "socket",
        "nslookup", "dig ", "Resolve-DnsName"
    ] nocase
    $destination = ["webhook.site", "requestbin", "ngrok", "trycloudflare", "pastebin", "transfer.sh", "api.telegram.org", "discord.com/api/webhooks"] nocase
    $metadata = ["169.254.169.254", "169.254.170.2", "metadata.google.internal"] nocase
    $sensitive = [
        "password", "private key", "api key", "access token", "credentials", "authorization",
        "client secret", "bearer token", "session token", "session cookie"
    ] nocase
parameters:
    threshold: number
condition:
    any call in tool_calls where
        (call.raw_arguments contains_any $transfer or
         call.raw_arguments contains_any $network or
         call.raw_arguments contains_any $destination or
         call.raw_arguments contains_any $metadata or
         call.raw_arguments contains_any $sensitive) and
        (model("sensitive_data_egress_judge").score(message("user", call.name).add_message("user", call.raw_arguments), text_ref("sensitive_data_egress_policy")) >= params.threshold)
