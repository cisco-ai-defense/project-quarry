rule "core/coding-agents-runtime-behavior-rules/configuration_persistence_fetch_execute_content_write"
metadata:
    title = "Remote execution in agent configuration"
    description = "Select tool calls mentioning agent configuration and remote execution indicators, then score the individual call for a persistent instruction or hook."
    author = "Cisco AI Defense"
    severity = "HIGH"
    revision = "0"
    updated = "2026-10-14"
    requires_quarry = ">=0.1.0,<0.2.0"
    taxonomy_objective = "Persistence"
    taxonomy_technique = "Configuration Persistence"
    taxonomy_subtechnique = "Agent Profile Tampering"
    signal_channel = "tool_calls"
strings:
    $agent_files = [
        "AGENTS.md", "CLAUDE.md", "GEMINI.md", "SKILL.md", "copilot-instructions.md",
        "settings.json", "config.toml", ".cursor/rules", ".clinerules", ".windsurfrules"
    ] nocase
    $execution_terms = [
        "curl", "wget", "Invoke-WebRequest", "Invoke-RestMethod", "DownloadString",
        "Invoke-Expression", "PowerShell", "bash", "sh -c",
        "download and run", "download and execute", "fetch and execute"
    ] nocase
parameters:
    threshold: number policy
condition:
    any call in tool_calls where
        (call.raw_arguments contains_any $agent_files) and
        (call.raw_arguments contains_any $execution_terms) and
        (model("configuration_persistence_judge").score(
            message("user", call.name).add_message("user", call.raw_arguments),
            text_ref("configuration_persistence_policy")) > params.threshold)
