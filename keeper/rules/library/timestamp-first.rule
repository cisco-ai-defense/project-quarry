rule "Timestamp first"
metadata:
    severity = "low"
    description = "Every reply with text must start with a bold New York timestamp, for example **Fri Nov 6, 2026 · 2:55 PM EST**."
    plain = "A reply didn't start with the date and time."
strings:
    $stamp = "^[*][*](Mon|Tue|Wed|Thu|Fri|Sat|Sun) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9]{1,2}, [0-9]{4} · [0-9]{1,2}:[0-9]{2} (AM|PM) (EST|EDT)[*][*]" regex
condition:
    any msg in assistant_messages where len(msg.content) > 0 and not ($stamp in msg.content)
