rule "No plain HTTP"
metadata:
    severity = "high"
    description = "Every connection must be encrypted. A reply or tool call used a plain http:// address."
    plain = "The AI tried to use an unencrypted web address (http:// instead of https://)."
strings:
    $plain = "http://" nocase
condition:
    any msg in assistant_messages where $plain in msg.content
    or
    any call in tool_calls where $plain in call.arguments.*
