rule "Secret in output"
metadata:
    severity = "high"
    description = "A reply or tool call contains something shaped like an API key, token, or private key."
    plain = "The AI was about to show or send a password-like secret."
strings:
    $secret = "(sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{32,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}|xox[abpr]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)" regex
condition:
    any msg in assistant_messages where $secret in msg.content
    or
    any call in tool_calls where $secret in call.arguments.*
